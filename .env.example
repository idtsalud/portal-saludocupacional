# Copiar este archivo como .env.local y completar los valores.
# Nunca subir .env.local a ningún repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service_role). Solo se usa en el servidor: invitar usuarios y sincronizar avisos.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública del portal (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sheets de Aviso Médico (cuenta de servicio de Google Cloud con la API de Sheets habilitada)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La clave privada de la cuenta de servicio, entre comillas, con los \n tal cual vienen en el JSON
GOOGLE_PRIVATE_KEY=
# El ID está en la URL de la planilla: docs.google.com/spreadsheets/d/<ID>/edit
AVISOS_SHEET_ID=
# Hoja y rango donde están los avisos (la primera fila tiene que ser el encabezado)
AVISOS_SHEET_RANGE=Avisos!A:Z

# Intranet de clientes IDT (historia clínica laboral)
NEXT_PUBLIC_INTRANET_URL=http://idtsalud.ddns.net:8030/Inicio.aspx

# Secreto para la tarea programada que sincroniza los avisos (cualquier texto largo al azar)
CRON_SECRET=
